# 複製成 .env 後依環境調整(.env 已被 .gitignore 排除,勿提交真實機密)

# --- 資料庫 ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
# 容器間連線:host 用服務名 db;若後端原生在 WSL 跑,改成 localhost
DATABASE_URL=postgresql://rag:ragpass@db:5432/ragdb

# --- Ollama ---
# 容器內連 WSL 主機上的 Ollama
OLLAMA_HOST=http://host.docker.internal:11434
# 後端若原生在 WSL 跑,改用:
# OLLAMA_HOST=http://localhost:11434
# Embedding 模型與向量維度需對應:bge-m3→1024、nomic-embed-text→768
EMBED_MODEL=bge-m3
EMBEDDING_DIM=1024
GEN_MODEL=qwen2.5:7b

# --- 前端 ---
# vite preview/dev 的 /api 代理目標;compose 內指向 backend 服務
VITE_PROXY_TARGET=http://backend:8000
